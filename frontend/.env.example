# Backend origin; use a reachable HTTPS address for production / real devices.
VITE_API_BASE_URL=http://localhost:8080
# Explicit development-only identity. Never enabled in a production build.
VITE_ENABLE_MOCK_LOGIN=false
# Set to wechat when the backend has WECHAT_APP_ID and WECHAT_APP_SECRET configured.
VITE_AUTH_MODE=disabled
