{
  "name": "ynu-shotting-booking",
  "version": "1.0.0",
  "description": "云大射击预约小程序",
  "main": "main.js",
  "scripts": {
    "dev:mp-weixin": "uni -p mp-weixin",
    "build:mp-weixin": "uni build -p mp-weixin",
    "build:mp-weixin:teamtest": "uni build -p mp-weixin --mode teamtest --outDir dist/teamtest/mp-weixin",
    "dev:h5": "uni",
    "build:h5": "uni build",
    "icons:tabbar": "node scripts/generate-tabbar-icons.mjs",
    "test": "node --test tests/*.test.mjs",
    "dev:integration": "uni --mode integration --host 127.0.0.1 --port 5174"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5020620260917001",
    "@dcloudio/uni-app-plus": "3.0.0-5020620260917001",
    "@dcloudio/uni-components": "3.0.0-5020620260917001",
    "@dcloudio/uni-h5": "3.0.0-5020620260917001",
    "@dcloudio/uni-mp-weixin": "3.0.0-5020620260917001",
    "@dcloudio/uni-quickapp-webview": "3.0.0-5020620260917001",
    "vue": "~3.4.0",
    "vue-i18n": "^9.0.0"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.0",
    "@dcloudio/uni-automator": "3.0.0-5020620260917001",
    "@dcloudio/uni-cli-shared": "3.0.0-5020620260917001",
    "@dcloudio/uni-stacktracey": "3.0.0-5020620260917001",
    "@dcloudio/vite-plugin-uni": "3.0.0-5020620260917001",
    "@element-plus/icons-vue": "^2.3.2",
    "@resvg/resvg-js": "^2.6.2",
    "@vue/server-renderer": "^3.4.38",
    "sass": "^1.70.0",
    "vite": "^5.0.0"
  }
